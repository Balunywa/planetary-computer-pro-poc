#    "user_impersonation" delegated permission, and give your user GeoCatalog Reader on
#    the catalog. Then paste the Overview page values here:
VITE_ENTRA_TENANT_ID=REPLACE_WITH_DIRECTORY_TENANT_ID
VITE_ENTRA_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID

VITE_GEOCATALOG_API_VERSION=2025-04-30-preview
