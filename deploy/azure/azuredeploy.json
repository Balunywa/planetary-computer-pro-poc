{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "2897952050181712179"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "allowedValues": [
        "eastus",
        "northcentralus",
        "westeurope",
        "canadacentral",
        "uksouth"
      ],
      "metadata": {
        "description": "Azure region for all resources. Planetary Computer Pro GeoCatalog is available only in the regions listed here (Preview)."
      }
    },
    "geoCatalogName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 24,
      "metadata": {
        "description": "Name of the Planetary Computer Pro GeoCatalog resource. Lowercase letters and numbers, 3-24 characters. Leave blank to auto-generate a unique name."
      }
    },
    "geoCatalogTier": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic"
      ],
      "metadata": {
        "description": "GeoCatalog service tier."
      }
    },
    "deployWorkstation": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the analytics workstation (Windows VM + VS Code + Python + Azure CLI) reached privately over Azure Bastion. It runs the sample ingestion script."
      }
    },
    "deploySampleStorage": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy a sample-data storage account and a user-assigned managed identity for the managed-identity ingestion path (bring-your-own-data scenario)."
      }
    },
    "seedSampleData": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "At deploy time, headlessly create a sample STAC collection and ingest a few Sentinel-2 scenes into the GeoCatalog (using the workstation identity) so the Explorer already shows imagery on first open. Requires the workstation."
      }
    },
    "deployWebApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the StormLens web app (a branded showcase + live map explorer over the GeoCatalog) to Azure Static Web Apps, and also serve it locally on the workstation."
      }
    },
    "staticWebAppLocation": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": [
        "",
        "westus2",
        "centralus",
        "eastus2",
        "westeurope",
        "eastasia"
      ],
      "metadata": {
        "description": "Optional override for the StormLens Static Web App region. Leave blank to automatically co-locate the web app with the main deployment region (it maps to the nearest supported Static Web Apps region when the main region is not one of them). Static Web Apps is only offered in a few regions; content is served globally from the CDN regardless of this value."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser",
      "metadata": {
        "description": "Administrator username for the workstation VM."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Administrator password for the workstation VM (used for RDP over the Azure Bastion tunnel). Leave empty when not deploying the workstation."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v3",
      "metadata": {
        "description": "Size of the workstation VM."
      }
    },
    "artifactsBaseUrl": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/Balunywa/planetary-computer-pro-poc/main/deploy/azure",
      "metadata": {
        "description": "Base URL (raw) that hosts setup.ps1. Point this at your fork if you change the provisioning script."
      }
    },
    "officialRepoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/Azure/microsoft-planetary-computer-pro.git",
      "metadata": {
        "description": "Git repository the workstation clones — the official Microsoft Planetary Computer Pro samples/notebooks/apps/tools. Point this at a fork if desired."
      }
    },
    "deployAiAgent": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy an Azure OpenAI (Microsoft Foundry) account + model deployment for agentic / reasoning GeoAI scenarios against the GeoCatalog."
      }
    },
    "openAiDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-5-mini",
      "metadata": {
        "description": "Name of the Azure OpenAI (Foundry) model deployment."
      }
    },
    "openAiModelName": {
      "type": "string",
      "defaultValue": "gpt-5-mini",
      "metadata": {
        "description": "Azure OpenAI model name."
      }
    },
    "openAiModelVersion": {
      "type": "string",
      "defaultValue": "2025-08-07",
      "metadata": {
        "description": "Azure OpenAI model version."
      }
    },
    "openAiSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Azure OpenAI deployment SKU."
      }
    },
    "openAiCapacity": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Azure OpenAI deployment capacity, in thousands of tokens per minute (TPM)."
      }
    },
    "deployAuroraModel": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy the Microsoft Aurora weather foundation model on a GPU-backed Foundry managed-compute endpoint. Requires GPU (A100) quota, an Azure Marketplace subscription, and acceptance of the model terms."
      }
    },
    "auroraInstanceType": {
      "type": "string",
      "defaultValue": "Standard_NC24ads_A100_v4",
      "metadata": {
        "description": "GPU VM size for the Aurora managed-compute deployment. Aurora requires an A100-class SKU; you must have quota for it in the selected region."
      }
    },
    "auroraModelAssetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Registry model asset ID for the Aurora managed-compute deployment. The official Microsoft storm-impact app uses azureml://registries/azureml/models/Aurora/versions/4. Leave blank to provision the Foundry workspace + endpoint only and deploy the model from the portal (the GPU deployment needs quota + accepted terms)."
      }
    }
  },
  "variables": {
    "namePrefix": "pcpro",
    "effectiveGeoCatalogName": "[if(empty(parameters('geoCatalogName')), toLower(format('pcpro{0}', uniqueString(resourceGroup().id))), parameters('geoCatalogName'))]",
    "vnetName": "[format('{0}-vnet', variables('namePrefix'))]",
    "nsgName": "[format('{0}-workstation-nsg', variables('namePrefix'))]",
    "bastionName": "[format('{0}-bastion', variables('namePrefix'))]",
    "bastionPipName": "[format('{0}-bastion-pip', variables('namePrefix'))]",
    "workstationName": "[format('{0}-workstation', variables('namePrefix'))]",
    "workstationNicName": "[format('{0}-workstation-nic', variables('namePrefix'))]",
    "sampleStorageName": "[toLower(format('pcpro{0}', uniqueString(resourceGroup().id)))]",
    "ingestIdentityName": "[format('{0}-ingest-identity', variables('namePrefix'))]",
    "sampleContainerName": "sample-assets",
    "modelOutputsContainerName": "model-outputs",
    "storageBlobDataReaderRoleId": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "geoCatalogAdminRoleId": "c9c97b9c-105d-4bb5-a2a7-7d15666c2484",
    "networkNeeded": "[parameters('deployWorkstation')]",
    "openAiName": "[toLower(format('pcpro-oai-{0}', uniqueString(resourceGroup().id)))]",
    "cognitiveServicesOpenAiUserRoleId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
    "amlSuffix": "[take(uniqueString(resourceGroup().id), 8)]",
    "amlWorkspaceName": "[format('pcpro-aml-{0}', variables('amlSuffix'))]",
    "amlStorageName": "[toLower(format('pcproaml{0}', take(uniqueString(resourceGroup().id), 12)))]",
    "amlKeyVaultName": "[format('pcpro-kv-{0}', variables('amlSuffix'))]",
    "auroraEndpointName": "[format('aurora-{0}', variables('amlSuffix'))]",
    "auroraDeploymentName": "aurora",
    "deployAuroraDeployment": "[and(parameters('deployAuroraModel'), not(empty(parameters('auroraModelAssetId'))))]",
    "staticWebAppName": "[format('pcpro-stormlens-{0}', variables('amlSuffix'))]",
    "staticWebAppRegionForLocation": {
      "eastus": "eastus2",
      "northcentralus": "centralus",
      "westeurope": "westeurope",
      "canadacentral": "eastus2",
      "uksouth": "westeurope"
    },
    "effectiveStaticWebAppLocation": "[if(empty(parameters('staticWebAppLocation')), variables('staticWebAppRegionForLocation')[parameters('location')], parameters('staticWebAppLocation'))]",
    "webAppBaseUrl": "[format('{0}/webapp', parameters('artifactsBaseUrl'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Orbital/geoCatalogs",
      "apiVersion": "2026-04-15",
      "name": "[variables('effectiveGeoCatalogName')]",
      "location": "[parameters('location')]",
      "identity": "[if(parameters('deploySampleStorage'), createObject('type', 'UserAssigned', 'userAssignedIdentities', createObject(format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName'))), createObject())), null())]",
      "properties": {
        "tier": "[parameters('geoCatalogTier')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName'))]"
      ]
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('ingestIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('sampleStorageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('sampleStorageName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]"
      ]
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('sampleStorageName'), 'default', variables('sampleContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('sampleStorageName'), 'default')]"
      ]
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('sampleStorageName'), 'default', variables('modelOutputsContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('sampleStorageName'), 'default')]"
      ]
    },
    {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), variables('ingestIdentityName'), variables('storageBlobDataReaderRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataReaderRoleId'))]",
        "principalId": "[if(parameters('deploySampleStorage'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName')), '2023-01-31').principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]"
      ]
    },
    {
      "condition": "[and(parameters('deploySampleStorage'), parameters('deployWorkstation'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), variables('workstationName'), variables('storageBlobDataContributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[if(parameters('deployWorkstation'), reference(resourceId('Microsoft.Compute/virtualMachines', variables('workstationName')), '2023-09-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('workstationName'))]"
      ]
    },
    {
      "condition": "[and(parameters('deployWorkstation'), parameters('seedSampleData'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]",
      "name": "[guid(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), variables('workstationName'), variables('geoCatalogAdminRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('geoCatalogAdminRoleId'))]",
        "principalId": "[if(parameters('deployWorkstation'), reference(resourceId('Microsoft.Compute/virtualMachines', variables('workstationName')), '2023-09-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('workstationName'))]"
      ]
    },
    {
      "condition": "[variables('networkNeeded')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-11-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": []
      }
    },
    {
      "condition": "[variables('networkNeeded')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.20.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "workstation-subnet",
            "properties": {
              "addressPrefix": "10.20.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          },
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "10.20.2.0/26"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ]
    },
    {
      "condition": "[variables('networkNeeded')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-11-01",
      "name": "[variables('bastionPipName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "condition": "[variables('networkNeeded')]",
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2023-11-01",
      "name": "[variables('bastionName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "enableTunneling": true,
        "ipConfigurations": [
          {
            "name": "bastion-ipconfig",
            "properties": {
              "subnet": {
                "id": "[if(variables('networkNeeded'), format('{0}/subnets/AzureBastionSubnet', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))), '')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPipName'))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPipName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWorkstation')]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-11-01",
      "name": "[variables('workstationNicName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[if(variables('networkNeeded'), format('{0}/subnets/workstation-subnet', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))), '')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWorkstation')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('workstationName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "pcpro-ws",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "2022-datacenter-azure-edition",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('workstationNicName'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('workstationNicName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWorkstation')]",
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', variables('workstationName'), 'provision-workstation')]",
      "location": "[parameters('location')]",
      "properties": {
        "source": {
          "scriptUri": "[format('{0}/setup.ps1', parameters('artifactsBaseUrl'))]"
        },
        "parameters": [
          {
            "name": "GeoCatalogName",
            "value": "[variables('effectiveGeoCatalogName')]"
          },
          {
            "name": "GeoCatalogRegion",
            "value": "[parameters('location')]"
          },
          {
            "name": "GeoCatalogUri",
            "value": "[reference(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), '2026-04-15').catalogUri]"
          },
          {
            "name": "RepoUrl",
            "value": "[parameters('officialRepoUrl')]"
          },
          {
            "name": "SampleContainerUrl",
            "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), '2023-05-01').primaryEndpoints.blob, variables('sampleContainerName')), '')]"
          },
          {
            "name": "UploadContainerUrl",
            "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), '2023-05-01').primaryEndpoints.blob, variables('modelOutputsContainerName')), '')]"
          },
          {
            "name": "IngestIdentityObjectId",
            "value": "[if(parameters('deploySampleStorage'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName')), '2023-01-31').principalId, '')]"
          },
          {
            "name": "FoundryEndpoint",
            "value": "[if(parameters('deployAiAgent'), reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), '2024-10-01').endpoint, '')]"
          },
          {
            "name": "FoundryDeployment",
            "value": "[if(parameters('deployAiAgent'), parameters('openAiDeploymentName'), '')]"
          },
          {
            "name": "AuroraEndpoint",
            "value": "[if(parameters('deployAuroraModel'), reference(resourceId('Microsoft.MachineLearningServices/workspaces/onlineEndpoints', variables('amlWorkspaceName'), variables('auroraEndpointName')), '2023-10-01').scoringUri, '')]"
          },
          {
            "name": "SeedSampleData",
            "value": "[string(and(parameters('deployWorkstation'), parameters('seedSampleData')))]"
          },
          {
            "name": "DeployWebApp",
            "value": "[string(parameters('deployWebApp'))]"
          },
          {
            "name": "WebAppBaseUrl",
            "value": "[if(parameters('deployWebApp'), variables('webAppBaseUrl'), '')]"
          },
          {
            "name": "WebAppUrl",
            "value": "[if(parameters('deployWebApp'), format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01').defaultHostname), '')]"
          }
        ],
        "protectedParameters": [
          {
            "name": "SwaDeploymentToken",
            "value": "[if(parameters('deployWebApp'), listSecrets(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01').properties.apiKey, '')]"
          }
        ],
        "timeoutInSeconds": 3600
      },
      "dependsOn": [
        "[resourceId('Microsoft.MachineLearningServices/workspaces/onlineEndpoints', variables('amlWorkspaceName'), variables('auroraEndpointName'))]",
        "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]",
        "[extensionResourceId(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), variables('workstationName'), variables('geoCatalogAdminRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
        "[resourceId('Microsoft.Web/staticSites', variables('staticWebAppName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('workstationName'))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), variables('workstationName'), variables('storageBlobDataContributorRoleId')))]"
      ]
    },
    {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('openAiName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('openAiName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('openAiName'), parameters('openAiDeploymentName'))]",
      "sku": {
        "name": "[parameters('openAiSkuName')]",
        "capacity": "[parameters('openAiCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('openAiModelName')]",
          "version": "[parameters('openAiModelVersion')]"
        },
        "versionUpgradeOption": "NoAutoUpgrade"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]"
      ]
    },
    {
      "condition": "[and(parameters('deployAiAgent'), parameters('deployWorkstation'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), variables('workstationName'), variables('cognitiveServicesOpenAiUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesOpenAiUserRoleId'))]",
        "principalId": "[if(parameters('deployWorkstation'), reference(resourceId('Microsoft.Compute/virtualMachines', variables('workstationName')), '2023-09-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('workstationName'))]"
      ]
    },
    {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), deployer().objectId, variables('cognitiveServicesOpenAiUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesOpenAiUserRoleId'))]",
        "principalId": "[deployer().objectId]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]"
      ]
    },
    {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('amlStorageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('amlKeyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "accessPolicies": []
      }
    },
    {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2023-10-01",
      "name": "[variables('amlWorkspaceName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[variables('amlWorkspaceName')]",
        "storageAccount": "[resourceId('Microsoft.Storage/storageAccounts', variables('amlStorageName'))]",
        "keyVault": "[resourceId('Microsoft.KeyVault/vaults', variables('amlKeyVaultName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('amlKeyVaultName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('amlStorageName'))]"
      ]
    },
    {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.MachineLearningServices/workspaces/onlineEndpoints",
      "apiVersion": "2023-10-01",
      "name": "[format('{0}/{1}', variables('amlWorkspaceName'), variables('auroraEndpointName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "authMode": "Key"
      },
      "dependsOn": [
        "[resourceId('Microsoft.MachineLearningServices/workspaces', variables('amlWorkspaceName'))]"
      ]
    },
    {
      "condition": "[variables('deployAuroraDeployment')]",
      "type": "Microsoft.MachineLearningServices/workspaces/onlineEndpoints/deployments",
      "apiVersion": "2023-10-01",
      "name": "[format('{0}/{1}/{2}', variables('amlWorkspaceName'), variables('auroraEndpointName'), variables('auroraDeploymentName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Default",
        "capacity": 1
      },
      "properties": {
        "endpointComputeType": "Managed",
        "model": "[parameters('auroraModelAssetId')]",
        "instanceType": "[parameters('auroraInstanceType')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.MachineLearningServices/workspaces/onlineEndpoints', variables('amlWorkspaceName'), variables('auroraEndpointName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[variables('staticWebAppName')]",
      "location": "[variables('effectiveStaticWebAppLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "sku": {
        "name": "Standard",
        "tier": "Standard"
      },
      "properties": {
        "allowConfigFileUpdates": true,
        "stagingEnvironmentPolicy": "Enabled"
      }
    }
  ],
  "outputs": {
    "geoCatalogResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]"
    },
    "geoCatalogUri": {
      "type": "string",
      "metadata": {
        "description": "The GeoCatalog URI (catalogUri), including the platform-assigned domain hash. Use as GEOCATALOG_URL for the ingest script and Explorer."
      },
      "value": "[reference(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), '2026-04-15').catalogUri]"
    },
    "geoCatalogPortalHint": {
      "type": "string",
      "metadata": {
        "description": "Open the GeoCatalog in the portal and copy the GeoCatalog URI from the Overview blade; use it as GEOCATALOG_URL for the ingest script and Explorer."
      },
      "value": "[format('Portal → {0} → Overview → GeoCatalog URI', variables('effectiveGeoCatalogName'))]"
    },
    "workstationName": {
      "type": "string",
      "value": "[if(parameters('deployWorkstation'), variables('workstationName'), 'not-deployed')]"
    },
    "bastionName": {
      "type": "string",
      "value": "[if(variables('networkNeeded'), variables('bastionName'), 'not-deployed')]"
    },
    "sampleStorageAccount": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), variables('sampleStorageName'), 'not-deployed')]"
    },
    "sampleContainer": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), variables('sampleContainerName'), 'not-deployed')]"
    },
    "sampleContainerUrl": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), '2023-05-01').primaryEndpoints.blob, variables('sampleContainerName')), 'not-deployed')]"
    },
    "aiAgentEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployAiAgent'), reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), '2024-10-01').endpoint, 'not-deployed')]"
    },
    "aiAgentDeployment": {
      "type": "string",
      "value": "[if(parameters('deployAiAgent'), parameters('openAiDeploymentName'), 'not-deployed')]"
    },
    "auroraWorkspace": {
      "type": "string",
      "value": "[if(parameters('deployAuroraModel'), variables('amlWorkspaceName'), 'not-deployed')]"
    },
    "auroraEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployAuroraModel'), variables('auroraEndpointName'), 'not-deployed')]"
    },
    "auroraModelDeployed": {
      "type": "bool",
      "value": "[variables('deployAuroraDeployment')]"
    },
    "ingestIdentityClientId": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName')), '2023-01-31').clientId, 'not-deployed')]"
    },
    "ingestIdentityObjectId": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName')), '2023-01-31').principalId, 'not-deployed')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[if(parameters('deployWebApp'), format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01').defaultHostname), 'not-deployed')]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "value": "[if(parameters('deployWebApp'), reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2023-12-01', 'full').identity.principalId, 'not-deployed')]"
    },
    "webAppRegion": {
      "type": "string",
      "metadata": {
        "description": "Region the Static Web App was placed in. Co-located with the main deployment region when Static Web Apps supports it, otherwise the nearest supported region."
      },
      "value": "[if(parameters('deployWebApp'), variables('effectiveStaticWebAppLocation'), 'not-deployed')]"
    }
  }
}