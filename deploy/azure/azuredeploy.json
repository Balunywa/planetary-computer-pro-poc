{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "15676062778251105036"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "allowedValues": [
        "eastus",
        "northcentralus",
        "westeurope",
        "canadacentral",
        "uksouth"
      ],
      "metadata": {
        "description": "Azure region for all resources. Planetary Computer Pro GeoCatalog is available only in the regions listed here (Preview)."
      }
    },
    "geoCatalogName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 24,
      "metadata": {
        "description": "Name of the Planetary Computer Pro GeoCatalog resource. Lowercase letters and numbers, 3-24 characters. Leave blank to auto-generate a unique name."
      }
    },
    "geoCatalogTier": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic"
      ],
      "metadata": {
        "description": "GeoCatalog service tier."
      }
    },
    "deploySampleStorage": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy a sample-data storage account and a user-assigned managed identity for the managed-identity ingestion path (bring-your-own-data scenario)."
      }
    },
    "deployWebApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the web app on an Azure App Service (Linux, Node). The site is created configured for Node; application code is published separately (CI/CD or `az webapp up`) and its managed identity is granted the GeoCatalog / storage / Foundry data-plane roles."
      }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service plan SKU for the web app (e.g. F1, B1, P0v3, P1v3)."
      }
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Microsoft Entra SPA app registration (client) ID the web app uses for MSAL sign-in. This is a public identifier, not a secret. Leave blank to have the deployment register the app automatically (see autoRegisterEntraApp)."
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Microsoft Entra tenant (directory) ID for sign-in. This is a public identifier, not a secret. Leave blank to use the tenant the deployment runs in."
      }
    },
    "autoRegisterEntraApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Automatically register the Microsoft Entra SPA app the web app signs in with, wiring its client ID into the site. Requires the person running the deployment to have rights to create app registrations (Application Administrator or Application.ReadWrite.All). Turn off to supply entraClientId yourself."
      }
    },
    "deployAiAgent": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy an Azure OpenAI (Microsoft Foundry) account + model deployment for agentic / reasoning GeoAI scenarios against the GeoCatalog."
      }
    },
    "openAiDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-5-mini",
      "metadata": {
        "description": "Name of the Azure OpenAI (Foundry) model deployment."
      }
    },
    "openAiModelName": {
      "type": "string",
      "defaultValue": "gpt-5-mini",
      "metadata": {
        "description": "Azure OpenAI model name."
      }
    },
    "openAiModelVersion": {
      "type": "string",
      "defaultValue": "2025-08-07",
      "metadata": {
        "description": "Azure OpenAI model version."
      }
    },
    "openAiSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Azure OpenAI deployment SKU."
      }
    },
    "openAiCapacity": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Azure OpenAI deployment capacity, in thousands of tokens per minute (TPM)."
      }
    },
    "deployAuroraModel": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy the Microsoft Aurora weather foundation model on a GPU-backed Foundry managed-compute endpoint. Requires GPU (A100) quota, an Azure Marketplace subscription, and acceptance of the model terms."
      }
    },
    "auroraInstanceType": {
      "type": "string",
      "defaultValue": "Standard_NC24ads_A100_v4",
      "metadata": {
        "description": "GPU VM size for the Aurora managed-compute deployment. Aurora requires an A100-class SKU; you must have quota for it in the selected region."
      }
    },
    "auroraModelAssetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Registry model asset ID for the Aurora managed-compute deployment. The official Microsoft storm-impact app uses azureml://registries/azureml/models/Aurora/versions/4. Leave blank to provision the Foundry workspace + endpoint only and deploy the model from the portal (the GPU deployment needs quota + accepted terms)."
      }
    }
  },
  "variables": {
    "namePrefix": "pcpro",
    "effectiveGeoCatalogName": "[if(empty(parameters('geoCatalogName')), toLower(format('pcpro{0}', uniqueString(resourceGroup().id))), parameters('geoCatalogName'))]",
    "appServicePlanName": "[format('{0}-plan-{1}', variables('namePrefix'), variables('amlSuffix'))]",
    "webAppName": "[format('pcpro-web-{0}', variables('amlSuffix'))]",
    "webAppHost": "[format('{0}.azurewebsites.net', variables('webAppName'))]",
    "registerEntraApp": "[and(parameters('deployWebApp'), parameters('autoRegisterEntraApp'))]",
    "effectiveEntraTenantId": "[if(empty(parameters('entraTenantId')), tenant().tenantId, parameters('entraTenantId'))]",
    "sampleStorageName": "[toLower(format('pcpro{0}', uniqueString(resourceGroup().id)))]",
    "ingestIdentityName": "[format('{0}-ingest-identity', variables('namePrefix'))]",
    "sampleContainerName": "sample-assets",
    "modelOutputsContainerName": "model-outputs",
    "storageBlobDataReaderRoleId": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "geoCatalogAdminRoleId": "c9c97b9c-105d-4bb5-a2a7-7d15666c2484",
    "openAiName": "[toLower(format('pcpro-oai-{0}', uniqueString(resourceGroup().id)))]",
    "cognitiveServicesOpenAiUserRoleId": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
    "amlSuffix": "[take(uniqueString(resourceGroup().id), 8)]",
    "amlWorkspaceName": "[format('pcpro-aml-{0}', variables('amlSuffix'))]",
    "amlStorageName": "[toLower(format('pcproaml{0}', take(uniqueString(resourceGroup().id), 12)))]",
    "amlKeyVaultName": "[format('pcpro-kv-{0}', variables('amlSuffix'))]",
    "auroraEndpointName": "[format('aurora-{0}', variables('amlSuffix'))]",
    "auroraDeploymentName": "aurora",
    "deployAuroraDeployment": "[and(parameters('deployAuroraModel'), not(empty(parameters('auroraModelAssetId'))))]"
  },
  "imports": {
    "microsoftGraphV1": {
      "provider": "MicrosoftGraph",
      "version": "0.2.0-preview"
    }
  },
  "resources": {
    "geoCatalog": {
      "type": "Microsoft.Orbital/geoCatalogs",
      "apiVersion": "2026-04-15",
      "name": "[variables('effectiveGeoCatalogName')]",
      "location": "[parameters('location')]",
      "identity": "[if(parameters('deploySampleStorage'), createObject('type', 'UserAssigned', 'userAssignedIdentities', createObject(format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('ingestIdentityName'))), createObject())), null())]",
      "properties": {
        "tier": "[parameters('geoCatalogTier')]"
      },
      "dependsOn": [
        "ingestIdentity"
      ]
    },
    "ingestIdentity": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('ingestIdentityName')]",
      "location": "[parameters('location')]"
    },
    "sampleStorage": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('sampleStorageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    "sampleBlobService": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('sampleStorageName'), 'default')]",
      "dependsOn": [
        "sampleStorage"
      ]
    },
    "sampleContainer": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('sampleStorageName'), 'default', variables('sampleContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "sampleBlobService"
      ]
    },
    "modelOutputsContainer": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('sampleStorageName'), 'default', variables('modelOutputsContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "sampleBlobService"
      ]
    },
    "blobReaderAssignment": {
      "condition": "[parameters('deploySampleStorage')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), variables('ingestIdentityName'), variables('storageBlobDataReaderRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataReaderRoleId'))]",
        "principalId": "[if(parameters('deploySampleStorage'), reference('ingestIdentity').principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "ingestIdentity",
        "sampleStorage"
      ]
    },
    "appBlobContributorRole": {
      "condition": "[and(parameters('deploySampleStorage'), parameters('deployWebApp'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('sampleStorageName')), variables('webAppName'), variables('storageBlobDataContributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[if(parameters('deployWebApp'), reference('webApp', '2023-12-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "sampleStorage",
        "webApp"
      ]
    },
    "appGeoCatalogAdminRole": {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]",
      "name": "[guid(resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName')), variables('webAppName'), variables('geoCatalogAdminRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('geoCatalogAdminRoleId'))]",
        "principalId": "[if(parameters('deployWebApp'), reference('webApp', '2023-12-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "geoCatalog",
        "webApp"
      ]
    },
    "openAi": {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('openAiName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('openAiName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    "openAiDeployment": {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('openAiName'), parameters('openAiDeploymentName'))]",
      "sku": {
        "name": "[parameters('openAiSkuName')]",
        "capacity": "[parameters('openAiCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('openAiModelName')]",
          "version": "[parameters('openAiModelVersion')]"
        },
        "versionUpgradeOption": "NoAutoUpgrade"
      },
      "dependsOn": [
        "openAi"
      ]
    },
    "openAiWebAppRole": {
      "condition": "[and(parameters('deployAiAgent'), parameters('deployWebApp'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), variables('webAppName'), variables('cognitiveServicesOpenAiUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesOpenAiUserRoleId'))]",
        "principalId": "[if(parameters('deployWebApp'), reference('webApp', '2023-12-01', 'full').identity.principalId, '')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "openAi",
        "webApp"
      ]
    },
    "openAiDeployerRole": {
      "condition": "[parameters('deployAiAgent')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('openAiName')), deployer().objectId, variables('cognitiveServicesOpenAiUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesOpenAiUserRoleId'))]",
        "principalId": "[deployer().objectId]"
      },
      "dependsOn": [
        "openAi"
      ]
    },
    "amlStorage": {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('amlStorageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    "amlKeyVault": {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('amlKeyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "accessPolicies": []
      }
    },
    "amlWorkspace": {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2023-10-01",
      "name": "[variables('amlWorkspaceName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[variables('amlWorkspaceName')]",
        "storageAccount": "[resourceId('Microsoft.Storage/storageAccounts', variables('amlStorageName'))]",
        "keyVault": "[resourceId('Microsoft.KeyVault/vaults', variables('amlKeyVaultName'))]"
      },
      "dependsOn": [
        "amlKeyVault",
        "amlStorage"
      ]
    },
    "auroraEndpoint": {
      "condition": "[parameters('deployAuroraModel')]",
      "type": "Microsoft.MachineLearningServices/workspaces/onlineEndpoints",
      "apiVersion": "2023-10-01",
      "name": "[format('{0}/{1}', variables('amlWorkspaceName'), variables('auroraEndpointName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "authMode": "Key"
      },
      "dependsOn": [
        "amlWorkspace"
      ]
    },
    "auroraDeployment": {
      "condition": "[variables('deployAuroraDeployment')]",
      "type": "Microsoft.MachineLearningServices/workspaces/onlineEndpoints/deployments",
      "apiVersion": "2023-10-01",
      "name": "[format('{0}/{1}/{2}', variables('amlWorkspaceName'), variables('auroraEndpointName'), variables('auroraDeploymentName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Default",
        "capacity": 1
      },
      "properties": {
        "endpointComputeType": "Managed",
        "model": "[parameters('auroraModelAssetId')]",
        "instanceType": "[parameters('auroraInstanceType')]"
      },
      "dependsOn": [
        "auroraEndpoint"
      ]
    },
    "entraApp": {
      "condition": "[variables('registerEntraApp')]",
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "[format('pcpro-web-{0}', variables('amlSuffix'))]",
        "displayName": "[format('Planetary Computer Pro Ops ({0})', variables('amlSuffix'))]",
        "signInAudience": "AzureADMyOrg",
        "spa": {
          "redirectUris": [
            "[format('https://{0}/auth/callback', variables('webAppHost'))]"
          ]
        },
        "web": {
          "logoutUrl": "[format('https://{0}/', variables('webAppHost'))]"
        }
      }
    },
    "entraAppSp": {
      "condition": "[variables('registerEntraApp')]",
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "[reference('entraApp').appId]"
      },
      "dependsOn": [
        "entraApp"
      ]
    },
    "appServicePlan": {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServiceSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    "webApp": {
      "condition": "[parameters('deployWebApp')]",
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "node server.mjs",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "GEOCATALOG_URI",
              "value": "[reference('geoCatalog').catalogUri]"
            },
            {
              "name": "GEOCATALOG_API_VERSION",
              "value": "2025-04-30-preview"
            },
            {
              "name": "ENTRA_TENANT_ID",
              "value": "[variables('effectiveEntraTenantId')]"
            },
            {
              "name": "ENTRA_CLIENT_ID",
              "value": "[if(variables('registerEntraApp'), reference('entraApp').appId, parameters('entraClientId'))]"
            },
            {
              "name": "FOUNDRY_ENDPOINT",
              "value": "[if(parameters('deployAiAgent'), reference('openAi').endpoint, '')]"
            },
            {
              "name": "FOUNDRY_DEPLOYMENT",
              "value": "[if(parameters('deployAiAgent'), parameters('openAiDeploymentName'), '')]"
            },
            {
              "name": "AURORA_ENDPOINT",
              "value": "[if(parameters('deployAuroraModel'), reference('auroraEndpoint').scoringUri, '')]"
            },
            {
              "name": "SAMPLE_CONTAINER_URL",
              "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference('sampleStorage').primaryEndpoints.blob, variables('sampleContainerName')), '')]"
            },
            {
              "name": "UPLOAD_CONTAINER_URL",
              "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference('sampleStorage').primaryEndpoints.blob, variables('modelOutputsContainerName')), '')]"
            },
            {
              "name": "UPLOAD_CONTAINER_NAME",
              "value": "[variables('modelOutputsContainerName')]"
            }
          ]
        }
      },
      "dependsOn": [
        "appServicePlan",
        "auroraEndpoint",
        "entraApp",
        "geoCatalog",
        "openAi",
        "sampleStorage"
      ]
    }
  },
  "outputs": {
    "geoCatalogResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Orbital/geoCatalogs', variables('effectiveGeoCatalogName'))]"
    },
    "geoCatalogUri": {
      "type": "string",
      "metadata": {
        "description": "The GeoCatalog URI (catalogUri), including the platform-assigned domain hash. Use as GEOCATALOG_URL for the ingest script and Explorer."
      },
      "value": "[reference('geoCatalog').catalogUri]"
    },
    "geoCatalogPortalHint": {
      "type": "string",
      "metadata": {
        "description": "Open the GeoCatalog in the portal and copy the GeoCatalog URI from the Overview blade; use it as GEOCATALOG_URL for the ingest script and Explorer."
      },
      "value": "[format('Portal → {0} → Overview → GeoCatalog URI', variables('effectiveGeoCatalogName'))]"
    },
    "sampleStorageAccount": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), variables('sampleStorageName'), 'not-deployed')]"
    },
    "sampleContainer": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), variables('sampleContainerName'), 'not-deployed')]"
    },
    "sampleContainerUrl": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), format('{0}{1}', reference('sampleStorage').primaryEndpoints.blob, variables('sampleContainerName')), 'not-deployed')]"
    },
    "aiAgentEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployAiAgent'), reference('openAi').endpoint, 'not-deployed')]"
    },
    "aiAgentDeployment": {
      "type": "string",
      "value": "[if(parameters('deployAiAgent'), parameters('openAiDeploymentName'), 'not-deployed')]"
    },
    "auroraWorkspace": {
      "type": "string",
      "value": "[if(parameters('deployAuroraModel'), variables('amlWorkspaceName'), 'not-deployed')]"
    },
    "auroraEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployAuroraModel'), variables('auroraEndpointName'), 'not-deployed')]"
    },
    "auroraModelDeployed": {
      "type": "bool",
      "value": "[variables('deployAuroraDeployment')]"
    },
    "ingestIdentityClientId": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), reference('ingestIdentity').clientId, 'not-deployed')]"
    },
    "ingestIdentityObjectId": {
      "type": "string",
      "value": "[if(parameters('deploySampleStorage'), reference('ingestIdentity').principalId, 'not-deployed')]"
    },
    "webAppName": {
      "type": "string",
      "value": "[if(parameters('deployWebApp'), variables('webAppName'), 'not-deployed')]"
    },
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "Public URL of the web app. Deploy application code with `az webapp up` (or CI/CD) from the webapp/ folder; Oryx runs npm install + npm run build and starts `node server.mjs`."
      },
      "value": "[if(parameters('deployWebApp'), format('https://{0}', reference('webApp').defaultHostName), 'not-deployed')]"
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Entra client (application) ID the web app signs in with — either the auto-registered app or the entraClientId parameter."
      },
      "value": "[if(parameters('deployWebApp'), if(variables('registerEntraApp'), reference('entraApp').appId, parameters('entraClientId')), 'not-deployed')]"
    },
    "entraTenantId": {
      "type": "string",
      "metadata": {
        "description": "Entra tenant (directory) ID the web app signs in with."
      },
      "value": "[variables('effectiveEntraTenantId')]"
    },
    "entraAppAutoRegistered": {
      "type": "bool",
      "metadata": {
        "description": "Whether the deployment registered the Entra app automatically. When false, set entraClientId (and grant the SPA redirect URI below) yourself."
      },
      "value": "[variables('registerEntraApp')]"
    },
    "entraRedirectUri": {
      "type": "string",
      "metadata": {
        "description": "SPA redirect URI the Entra app must trust. Auto-registered when entraAppAutoRegistered is true; add it manually otherwise."
      },
      "value": "[if(parameters('deployWebApp'), format('https://{0}/auth/callback', variables('webAppHost')), 'not-deployed')]"
    }
  }
}