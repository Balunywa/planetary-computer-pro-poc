{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploy a Microsoft Planetary Computer Pro **GeoCatalog** plus optional components: an analytics workstation (VS Code + Python over Azure Bastion), sample-data storage, an Azure OpenAI (Microsoft Foundry) agent, and the Microsoft Aurora weather model on a GPU Foundry endpoint. The GeoCatalog is always deployed; choose the rest. [Learn more](https://github.com/Balunywa/planetary-computer-pro-poc).",
        "location": {
          "label": "Region",
          "toolTip": "GeoCatalog is available in these regions during Preview.",
          "resourceTypes": [
            "Microsoft.Orbital/geoCatalogs"
          ],
          "allowedValues": [
            "eastus",
            "northcentralus",
            "westeurope",
            "canadacentral",
            "uksouth"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "geoCatalogName",
        "type": "Microsoft.Common.TextBox",
        "label": "GeoCatalog name",
        "defaultValue": "",
        "toolTip": "Lowercase letters and numbers, 3-24 characters. Leave blank to auto-generate a unique name.",
        "constraints": {
          "required": false,
          "regex": "^[a-z0-9]{3,24}$",
          "validationMessage": "3-24 lowercase letters or numbers."
        }
      }
    ],
    "steps": [
      {
        "name": "components",
        "label": "Components",
        "elements": [
          {
            "name": "geoCatalogInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "The GeoCatalog is always deployed. Select any additional components below, then configure them on the following tabs."
            }
          },
          {
            "name": "selected",
            "type": "Microsoft.Common.DropDown",
            "label": "Optional components to deploy",
            "toolTip": "Select one or more components. Use Select all for the complete environment.",
            "multiselect": true,
            "selectAll": true,
            "defaultValue": [
              {
                "value": "workstation"
              },
              {
                "value": "sampleStorage"
              },
              {
                "value": "aiAgent"
              }
            ],
            "constraints": {
              "required": false,
              "allowedValues": [
                {
                  "label": "Analytics workstation + Azure Bastion",
                  "value": "workstation",
                  "description": "Windows VM (VS Code + Python + Git) with private RDP over Azure Bastion; clones the official repo."
                },
                {
                  "label": "Sample storage + ingestion identity",
                  "value": "sampleStorage",
                  "description": "Storage account and managed identity for the bring-your-own-data ingestion path."
                },
                {
                  "label": "AI agent (Azure OpenAI / Foundry)",
                  "value": "aiAgent",
                  "description": "Azure OpenAI account + GPT deployment for agentic / reasoning GeoAI scenarios."
                },
                {
                  "label": "Aurora weather model (GPU Foundry endpoint)",
                  "value": "auroraModel",
                  "description": "Foundry (Azure ML) workspace + GPU managed-compute endpoint for the Microsoft Aurora model. Requires A100 GPU quota + marketplace terms."
                }
              ]
            }
          }
        ]
      },
      {
        "name": "workstationConfig",
        "label": "Workstation",
        "elements": [
          {
            "name": "workstationRequired",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[not(contains(steps('components').selected, 'workstation'))]",
            "options": {
              "icon": "Info",
              "text": "The workstation is not selected. These settings are ignored."
            }
          },
          {
            "name": "adminUsername",
            "type": "Microsoft.Compute.UserNameTextBox",
            "label": "Administrator username",
            "defaultValue": "azureuser",
            "toolTip": "Administrator login for the workstation VM.",
            "osPlatform": "Windows",
            "constraints": {
              "required": "[contains(steps('components').selected, 'workstation')]"
            },
            "visible": "[contains(steps('components').selected, 'workstation')]"
          },
          {
            "name": "adminPassword",
            "type": "Microsoft.Compute.CredentialsCombo",
            "label": {
              "password": "Administrator password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": {
              "password": "Used for RDP over the Azure Bastion tunnel."
            },
            "osPlatform": "Windows",
            "constraints": {
              "required": "[contains(steps('components').selected, 'workstation')]"
            },
            "options": {
              "hideConfirmation": false
            },
            "visible": "[contains(steps('components').selected, 'workstation')]"
          },
          {
            "name": "vmSize",
            "type": "Microsoft.Compute.SizeSelector",
            "label": "Workstation size",
            "toolTip": "VM size for the workstation.",
            "recommendedSizes": [
              "Standard_D4s_v3",
              "Standard_D2s_v3"
            ],
            "constraints": {
              "allowedSizes": []
            },
            "osPlatform": "Windows",
            "imageReference": {
              "publisher": "MicrosoftWindowsServer",
              "offer": "WindowsServer",
              "sku": "2022-datacenter-azure-edition"
            },
            "count": 1,
            "visible": "[contains(steps('components').selected, 'workstation')]"
          }
        ]
      },
      {
        "name": "aiConfig",
        "label": "AI",
        "elements": [
          {
            "name": "aiRequired",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[and(not(contains(steps('components').selected, 'aiAgent')), not(contains(steps('components').selected, 'auroraModel')))]",
            "options": {
              "icon": "Info",
              "text": "No AI components are selected. These settings are ignored."
            }
          },
          {
            "name": "aiAgentSection",
            "type": "Microsoft.Common.Section",
            "label": "AI agent (Azure OpenAI / Foundry)",
            "visible": "[contains(steps('components').selected, 'aiAgent')]",
            "elements": [
              {
                "name": "openAiDeploymentName",
                "type": "Microsoft.Common.TextBox",
                "label": "Model deployment name",
                "defaultValue": "gpt-5-mini",
                "toolTip": "Name of the Azure OpenAI model deployment.",
                "constraints": {
                  "required": true,
                  "regex": "^[a-zA-Z0-9._-]{2,64}$",
                  "validationMessage": "Use 2-64 characters: letters, numbers, dot, dash or underscore."
                }
              }
            ]
          },
          {
            "name": "auroraSection",
            "type": "Microsoft.Common.Section",
            "label": "Aurora weather model (GPU)",
            "visible": "[contains(steps('components').selected, 'auroraModel')]",
            "elements": [
              {
                "name": "auroraInfo",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                  "icon": "Warning",
                  "text": "Aurora runs on a GPU managed-compute endpoint (Standard_NC24ads_A100_v4). The Foundry workspace + endpoint always deploy; the GPU model only deploys when you supply a model asset ID and have A100 quota + accepted marketplace terms."
                }
              },
              {
                "name": "auroraInstanceType",
                "type": "Microsoft.Common.TextBox",
                "label": "GPU instance type",
                "defaultValue": "Standard_NC24ads_A100_v4",
                "toolTip": "GPU VM size for the Aurora managed-compute deployment. You must have quota for it in the selected region.",
                "constraints": {
                  "required": true,
                  "regex": "^[A-Za-z0-9_]{4,64}$",
                  "validationMessage": "Enter a valid VM size, e.g. Standard_NC24ads_A100_v4."
                }
              },
              {
                "name": "auroraModelAssetId",
                "type": "Microsoft.Common.TextBox",
                "label": "Aurora model asset ID (optional)",
                "defaultValue": "",
                "toolTip": "Registry model asset, e.g. azureml://registries/azureml/models/<Aurora-model>/versions/<n>. Leave blank to provision the workspace + endpoint only and deploy the model from the portal.",
                "constraints": {
                  "required": false
                }
              }
            ]
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "geoCatalogName": "[basics('geoCatalogName')]",
      "deployWorkstation": "[contains(steps('components').selected, 'workstation')]",
      "deploySampleStorage": "[contains(steps('components').selected, 'sampleStorage')]",
      "deployAiAgent": "[contains(steps('components').selected, 'aiAgent')]",
      "deployAuroraModel": "[contains(steps('components').selected, 'auroraModel')]",
      "adminUsername": "[if(contains(steps('components').selected, 'workstation'), steps('workstationConfig').adminUsername, 'azureuser')]",
      "adminPassword": "[if(contains(steps('components').selected, 'workstation'), steps('workstationConfig').adminPassword.password, '')]",
      "vmSize": "[if(contains(steps('components').selected, 'workstation'), steps('workstationConfig').vmSize, 'Standard_D4s_v3')]",
      "openAiDeploymentName": "[if(contains(steps('components').selected, 'aiAgent'), steps('aiConfig').aiAgentSection.openAiDeploymentName, 'gpt-5-mini')]",
      "auroraInstanceType": "[if(contains(steps('components').selected, 'auroraModel'), steps('aiConfig').auroraSection.auroraInstanceType, 'Standard_NC24ads_A100_v4')]",
      "auroraModelAssetId": "[if(contains(steps('components').selected, 'auroraModel'), steps('aiConfig').auroraSection.auroraModelAssetId, '')]"
    }
  }
}
