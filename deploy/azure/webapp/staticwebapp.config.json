{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/setup/*", "/wizard/*", "*.cmd", "*.ps1"]
  },
  "routes": [
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/StormLens-Setup.cmd", "headers": { "content-disposition": "attachment; filename=StormLens-Setup.cmd" } },
    { "route": "/StormLens-Deploy.cmd", "headers": { "content-disposition": "attachment; filename=StormLens-Deploy.cmd" } }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".cmd": "application/octet-stream",
    ".ps1": "text/plain"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  }
}
