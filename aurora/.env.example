# --- Aurora endpoint (the deployed Azure ML online endpoint) --------------------
# Scoring URI, e.g. https://pcpro-aml-xxxx-yyyy.westeurope.inference.ml.azure.com/score
AURORA_ENDPOINT=
# Endpoint key or AAD token. Never commit the real value.
AURORA_ENDPOINT_TOKEN=
# Model name registered on the endpoint deployment.
AURORA_MODEL_NAME=aurora-0.25-finetuned
# Number of 6-hour forecast steps to request (20 steps = 120 h, matching the app horizon).
AURORA_NUM_STEPS=20

# --- Blob transfer channel (Aurora passes tensors via blob, not HTTP body) ------
# A container URL WITH a read/write SAS token the endpoint can use as scratch space.
AURORA_BLOB_CHANNEL_URL=

# --- Initial conditions ---------------------------------------------------------
# "era5" (Copernicus CDS, requires ~/.cdsapirc) or "hres" (local GRIB files).
INITIAL_CONDITION_SOURCE=era5
# For INITIAL_CONDITION_SOURCE=hres: directory containing the two-timestep GRIB files.
HRES_INPUT_DIR=
# Optional explicit analysis time (UTC ISO, e.g. 2026-08-20T00:00:00). Defaults to
# the most recent synoptic cycle with data available.
ANALYSIS_TIME=

# --- Detection domain (limit tracking to the operating region) ------------------
# minLon,minLat,maxLon,maxLat. Default is the Gulf of Mexico / western Atlantic.
DETECTION_BBOX=-100,15,-70,35

# --- Output ---------------------------------------------------------------------
# The model-outputs container URL (no SAS) — used with managed identity on Azure.
OUTPUT_CONTAINER_URL=
# Local / non-managed-identity alternative: full SAS URL to the output container.
OUTPUT_SAS_URL=
# Blob name the web app reads.
OUTPUT_BLOB_NAME=weather-events.json
